# Base URL of the deployed web/API server (required for mobile app)
EXPO_PUBLIC_API_URL=http://localhost:4200

# Optional — used by Expo tunnel/proxy setups (Runable managed dev)
EXPO_PACKAGER_PROXY_URL=
