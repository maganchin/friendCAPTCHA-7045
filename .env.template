# =============================================================================
# FriendCAPTCHA — environment variables
# Copy to `.env` at the project root and fill in values.
#
#   cp .env.template .env
#
# Required to run the app:
#   - DATABASE_URL (+ DATABASE_AUTH_TOKEN for remote Turso)
#   - S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET
#
# Not used by this app (leftover from Runable template — safe to omit):
#   BETTER_AUTH_SECRET, AI_GATEWAY_*, AUTUMN_SECRET_KEY
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# development | production
NODE_ENV=development

# Public URL of the web app (used by the Electron desktop shell)
WEBSITE_URL=http://localhost:4200

# Server port — Vite dev uses 4200; production server defaults to 3000 if unset
PORT=4200


# -----------------------------------------------------------------------------
# Database — Turso / LibSQL (required)
# https://turso.tech
#
# Remote (production / Runable):
#   turso db create friendcaptcha
#   turso db show friendcaptcha --url
#   turso db tokens create friendcaptcha
#
# Local dev (no Turso account needed):
#   DATABASE_URL=file:local.db
#   DATABASE_AUTH_TOKEN=
#
# After setting these, push the schema:
#   cd packages/web && bun run db:push
# -----------------------------------------------------------------------------

DATABASE_URL=
DATABASE_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# Object storage — S3-compatible (required for photo uploads)
#
# Runable typically provisions Cloudflare R2. Any S3-compatible provider works:
#   - Cloudflare R2  https://developers.cloudflare.com/r2/
#   - AWS S3
#   - MinIO (self-hosted)
#
# R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=friendcaptcha
# -----------------------------------------------------------------------------

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=


# -----------------------------------------------------------------------------
# Runable analytics (optional)
# Only used to tag the analytics script hostname. Leave empty when self-hosting.
# -----------------------------------------------------------------------------

APPLICATION_ID=
